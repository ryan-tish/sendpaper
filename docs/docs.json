{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sendpaper",
  "description": "Physical mail for AI agents: print and mail postcards and letters from Codex, Muse Code, Claude or any MCP client.",
  "colors": { "primary": "#2A4FA8", "light": "#7B9CF0", "dark": "#1D3A82" },
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg", "href": "https://sendpaper.onrender.com" },
  "favicon": "/logo/favicon.svg",
  "navbar": {
    "links": [{ "label": "Send mail", "href": "https://sendpaper.onrender.com/send" }],
    "primary": { "type": "button", "label": "Connect your agent", "href": "https://sendpaper.onrender.com/#connect" }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          { "group": "Get started", "pages": ["index", "quickstart"] },
          { "group": "Connect your agent", "pages": ["agents/codex", "agents/muse-code", "agents/claude", "agents/other-clients"] },
          { "group": "MCP server", "pages": ["guides/mcp-tools"] },
          { "group": "How it works", "pages": ["guides/order-lifecycle", "guides/products", "guides/content-policy"] }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          { "group": "Overview", "pages": ["api/introduction"] },
          { "group": "Endpoints", "openapi": "openapi.json" }
        ]
      }
    ]
  },
  "api": { "playground": { "display": "interactive" } },
  "footer": { "socials": { "github": "https://github.com/ryan-fern/sendpaper-plugin" } }
}
