{
  "openapi": "3.1.0",
  "info": {
    "title": "Sendpaper API",
    "version": "1.0.0",
    "description": "Print and mail postcards and letters to US addresses. Every order returns a checkout_url a person pays; nothing is printed until then. No API key required."
  },
  "servers": [
    {
      "url": "https://sendmypaper.com/v1"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "summary": "List products",
        "description": "Products and prices. Prices include printing, envelope and USPS First-Class postage.",
        "operationId": "listProducts",
        "responses": {
          "200": {
            "description": "Products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pricing": {
      "get": {
        "summary": "Get pricing",
        "description": "Same response as GET /products (an alias, named like the MCP tool get_pricing). Prices include printing, envelope and USPS First-Class postage.",
        "operationId": "getPricing",
        "responses": {
          "200": {
            "description": "Products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/postcards": {
      "post": {
        "summary": "Create a postcard",
        "description": "Creates a 4\u00d76, 6\u00d79 or 6\u00d711 postcard order in `awaiting_payment` and returns a `checkout_url`. Send the person to it; the postcard is reviewed, printed and mailed after payment.\n\nTo send the same postcard to several people, pass `recipients` (2\u201325 addresses) instead of `to`. You get back a Batch: one order per recipient and a single `batch.checkout_url`. `POST /orders/{id}/pay` with any order in the batch pays for every unpaid order in it (scope the token to `batch.price`).",
        "operationId": "createPostcard",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostcard"
              },
              "examples": {
                "one": {
                  "summary": "One recipient",
                  "value": {
                    "size": "4x6",
                    "to": {
                      "name": "Sam Rivera",
                      "line1": "12 Oak St",
                      "city": "Austin",
                      "state": "TX",
                      "zip": "78701"
                    },
                    "from": {
                      "name": "Alex Kim",
                      "line1": "88 Pine Ave",
                      "city": "Denver",
                      "state": "CO",
                      "zip": "80202"
                    },
                    "content": {
                      "front_headline": "Happy birthday, Sam!",
                      "front_theme": "sunset",
                      "message": "Thirty looks great on you."
                    },
                    "customer_email": "alex@example.com"
                  }
                },
                "many": {
                  "summary": "Same postcard to several people",
                  "value": {
                    "size": "4x6",
                    "from": {
                      "name": "Alex Kim",
                      "line1": "88 Pine Ave",
                      "city": "Denver",
                      "state": "CO",
                      "zip": "80202"
                    },
                    "content": {
                      "front_headline": "Happy birthday, Sam!",
                      "front_theme": "sunset",
                      "message": "Thirty looks great on you."
                    },
                    "customer_email": "alex@example.com",
                    "recipients": [
                      {
                        "name": "Sam Rivera",
                        "line1": "12 Oak St",
                        "city": "Austin",
                        "state": "TX",
                        "zip": "78701"
                      },
                      {
                        "name": "Jo Park",
                        "line1": "12 Oak St",
                        "city": "Dayton",
                        "state": "OH",
                        "zip": "45402"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created (a Batch when the request used `recipients`)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Order"
                    },
                    {
                      "$ref": "#/components/schemas/Batch"
                    }
                  ]
                }
              }
            }
          },
          "200": {
            "description": "Idempotency-Key already used: the original order is returned (a Batch when the request used `recipients`)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Order"
                    },
                    {
                      "$ref": "#/components/schemas/Batch"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/letters": {
      "post": {
        "summary": "Create a letter",
        "description": "Creates a printed letter (up to ~3 pages, 8.5\u00d711, #10 envelope) in `awaiting_payment` and returns a `checkout_url`. Set `certified` to send it by USPS Certified Mail.\n\nTo send the same letter to several people, pass `recipients` (2\u201325 addresses) instead of `to`. You get back a Batch: one order per recipient and a single `batch.checkout_url`. `POST /orders/{id}/pay` with any order in the batch pays for every unpaid order in it (scope the token to `batch.price`).",
        "operationId": "createLetter",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLetter"
              },
              "examples": {
                "one": {
                  "summary": "One recipient",
                  "value": {
                    "to": {
                      "name": "Pat Lee",
                      "line1": "500 Main St",
                      "line2": "Apt 4",
                      "city": "Boston",
                      "state": "MA",
                      "zip": "02110"
                    },
                    "from": {
                      "name": "Alex Kim",
                      "line1": "88 Pine Ave",
                      "city": "Denver",
                      "state": "CO",
                      "zip": "80202"
                    },
                    "content": {
                      "body": "Dear Pat,\n\nThank you for fixing the roof so quickly.\n\nBest,\nAlex",
                      "font": "serif"
                    }
                  }
                },
                "many": {
                  "summary": "Same letter to several people",
                  "value": {
                    "from": {
                      "name": "Alex Kim",
                      "line1": "88 Pine Ave",
                      "city": "Denver",
                      "state": "CO",
                      "zip": "80202"
                    },
                    "content": {
                      "body": "Dear Pat,\n\nThank you for fixing the roof so quickly.\n\nBest,\nAlex",
                      "font": "serif"
                    },
                    "recipients": [
                      {
                        "name": "Sam Rivera",
                        "line1": "12 Oak St",
                        "city": "Austin",
                        "state": "TX",
                        "zip": "78701"
                      },
                      {
                        "name": "Jo Park",
                        "line1": "12 Oak St",
                        "city": "Dayton",
                        "state": "OH",
                        "zip": "45402"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created (a Batch when the request used `recipients`)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Order"
                    },
                    {
                      "$ref": "#/components/schemas/Batch"
                    }
                  ]
                }
              }
            }
          },
          "200": {
            "description": "Idempotency-Key already used: the original order is returned (a Batch when the request used `recipients`)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Order"
                    },
                    {
                      "$ref": "#/components/schemas/Batch"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Retrieve an order",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "ord_8k2m4qz7c1x9b3vd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "summary": "Cancel an unpaid order",
        "description": "Only orders in `awaiting_payment` can be cancelled here. For paid orders, email support before printing.",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Order is already paid or closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/pay": {
      "post": {
        "summary": "Pay with an agent token",
        "description": "Pay an unpaid order with a Stripe shared payment token (`spt_\u2026`) the user approved, scoped to at least the order amount in USD. Safe to retry with the same token.\n\nFor an order that belongs to a batch, this charges one token for every unpaid order in the batch; scope the token to the batch total.",
        "operationId": "payOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "shared_payment_token"
                ],
                "properties": {
                  "shared_payment_token": {
                    "type": "string",
                    "example": "spt_1Q..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "402": {
            "description": "Token rejected (token_amount, token_inactive, token_currency, requires_action, payment_failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Order already paid or closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Any unique string. Retrying with the same key returns the original order instead of creating a duplicate.",
        "schema": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "responses": {
      "Invalid": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such order",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Address": {
        "type": "object",
        "required": [
          "name",
          "line1",
          "city",
          "state",
          "zip"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "company": {
            "type": "string",
            "maxLength": 60
          },
          "line1": {
            "type": "string",
            "maxLength": 64,
            "description": "Street address"
          },
          "line2": {
            "type": "string",
            "maxLength": 64,
            "description": "Apartment, suite, unit"
          },
          "city": {
            "type": "string",
            "maxLength": 40
          },
          "state": {
            "type": "string",
            "description": "Two-letter US state or territory code",
            "example": "CA"
          },
          "zip": {
            "type": "string",
            "pattern": "^\\d{5}(-\\d{4})?$",
            "example": "94105"
          }
        }
      },
      "CreatePostcard": {
        "type": "object",
        "required": [
          "from",
          "content"
        ],
        "properties": {
          "size": {
            "type": "string",
            "enum": [
              "4x6",
              "6x9",
              "6x11"
            ],
            "default": "4x6"
          },
          "to": {
            "$ref": "#/components/schemas/Address",
            "description": "Recipient address Use `recipients` instead to send to several people."
          },
          "from": {
            "$ref": "#/components/schemas/Address",
            "description": "Return address, printed on the card. Required."
          },
          "content": {
            "type": "object",
            "required": [
              "message"
            ],
            "description": "Provide front_image_url or front_headline.",
            "properties": {
              "front_image_url": {
                "type": "string",
                "format": "uri",
                "description": "https URL of a JPG or PNG for the front"
              },
              "front_headline": {
                "type": "string",
                "maxLength": 60,
                "description": "Big text for a text-only front"
              },
              "front_theme": {
                "type": "string",
                "enum": [
                  "ink",
                  "sky",
                  "sunset",
                  "forest",
                  "rose",
                  "sand",
                  "night",
                  "mint"
                ],
                "default": "ink"
              },
              "message": {
                "type": "string",
                "maxLength": 600,
                "description": "Message on the back"
              },
              "layout": {
                "type": "string",
                "enum": [
                  "headline",
                  "photo",
                  "photo_caption",
                  "collage"
                ],
                "description": "Front layout; inferred when omitted."
              },
              "caption": {
                "type": "string",
                "maxLength": 80,
                "description": "photo_caption: text over the bottom of the photo."
              },
              "front_images": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 2,
                "maxItems": 4,
                "description": "collage: 2-4 https photo URLs."
              },
              "headline_font": {
                "type": "string",
                "enum": [
                  "serif",
                  "sans",
                  "script"
                ],
                "default": "serif"
              },
              "message_font": {
                "type": "string",
                "enum": [
                  "handwriting",
                  "serif",
                  "sans"
                ],
                "default": "handwriting"
              }
            }
          },
          "customer_email": {
            "type": "string",
            "format": "email"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Alternative to the Idempotency-Key header With `recipients`, a retry with the same key returns the same batch."
          },
          "express": {
            "type": "boolean",
            "default": false,
            "description": "USPS Priority Mail (2-3 days, tracked) for an extra charge."
          },
          "recipients": {
            "type": "array",
            "minItems": 2,
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "Send the same postcard or letter to several people: 2\u201325 addresses, used instead of `to`. Each recipient becomes its own order (own review, tracking and refund), grouped into a batch that is paid with one checkout link. The response is a Batch, not an Order."
          }
        },
        "oneOf": [
          {
            "required": [
              "to"
            ]
          },
          {
            "required": [
              "recipients"
            ]
          }
        ]
      },
      "CreateLetter": {
        "type": "object",
        "required": [
          "from",
          "content"
        ],
        "properties": {
          "to": {
            "$ref": "#/components/schemas/Address",
            "description": "Recipient address Use `recipients` instead to send to several people."
          },
          "from": {
            "$ref": "#/components/schemas/Address"
          },
          "content": {
            "type": "object",
            "required": [],
            "properties": {
              "body": {
                "type": "string",
                "maxLength": 9000,
                "description": "Plain text; blank lines separate paragraphs"
              },
              "font": {
                "type": "string",
                "enum": [
                  "serif",
                  "sans"
                ],
                "default": "serif"
              },
              "image_url": {
                "type": "string",
                "format": "uri",
                "description": "Optional https URL of a JPG or PNG printed under the date. A letter with a photo prints in color and costs $1.00 more."
              },
              "pdf_url": {
                "type": "string",
                "format": "uri",
                "description": "Mail your own PDF (public https link, up to 6 pages) instead of body. Pages are fitted to 8.5x11; an address page is added in front."
              },
              "color": {
                "type": "boolean",
                "description": "PDF letters: print in color (+$1.00)."
              }
            }
          },
          "customer_email": {
            "type": "string",
            "format": "email"
          },
          "idempotency_key": {
            "type": "string",
            "description": " With `recipients`, a retry with the same key returns the same batch."
          },
          "certified": {
            "type": "string",
            "enum": [
              "none",
              "certified",
              "certified_return_receipt"
            ],
            "default": "none",
            "description": "USPS Certified Mail. `certified` ($14.99): tracking number and proof of mailing and delivery. `certified_return_receipt` ($19.99): adds the recipient's signature. `none` ($4.99): regular First-Class."
          },
          "express": {
            "type": "boolean",
            "default": false,
            "description": "USPS Priority Mail (2-3 days, tracked); not with certified."
          },
          "recipients": {
            "type": "array",
            "minItems": 2,
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "Send the same postcard or letter to several people: 2\u201325 addresses, used instead of `to`. Each recipient becomes its own order (own review, tracking and refund), grouped into a batch that is paid with one checkout link. The response is a Batch, not an Order."
          }
        },
        "oneOf": [
          {
            "required": [
              "to"
            ]
          },
          {
            "required": [
              "recipients"
            ]
          }
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "postcard_4x6",
              "postcard_6x9",
              "postcard_6x11",
              "letter",
              "letter_certified",
              "letter_certified_rr"
            ]
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "blurb": {
            "type": "string"
          },
          "amount_cents": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "example": "usd"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ord_8k2m4qz7c1x9b3vd"
          },
          "object": {
            "type": "string",
            "enum": [
              "postcard",
              "letter"
            ]
          },
          "product": {
            "type": "string",
            "enum": [
              "postcard_4x6",
              "postcard_6x9",
              "postcard_6x11",
              "letter",
              "letter_certified",
              "letter_certified_rr"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_payment",
              "paid",
              "printing",
              "mailed",
              "cancelled",
              "refunded"
            ]
          },
          "status_detail": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "properties": {
              "amount_cents": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              },
              "display": {
                "type": "string"
              }
            }
          },
          "to": {
            "$ref": "#/components/schemas/Address"
          },
          "from": {
            "$ref": "#/components/schemas/Address"
          },
          "content": {
            "type": "object"
          },
          "checkout_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the person pays. Null once paid or closed. Never expires."
          },
          "order_url": {
            "type": "string",
            "description": "Human-readable status page"
          },
          "preview_url": {
            "type": "string",
            "description": "Exact print preview"
          },
          "preview_image_url": {
            "type": "string",
            "description": "PNG picture of the piece (postcard front over back, or the letter's first page) to show the person before they pay. Add ?w=400\u20132000 for a width in pixels."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "mailed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "certified": {
            "type": "string",
            "enum": [
              "none",
              "certified",
              "certified_return_receipt"
            ],
            "description": "Letters only: the USPS extra service."
          },
          "tracking": {
            "type": [
              "object",
              "null"
            ],
            "description": "USPS tracking once the piece is accepted (certified letters always get one).",
            "properties": {
              "number": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "batch_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when the order is part of a batch (created with `recipients`). Its checkout_url is then the batch's single payment link."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
