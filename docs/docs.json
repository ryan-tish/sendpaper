{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sendpaper",
  "description": "Physical mail for AI agents. Codex, Muse Code, Claude or any MCP client can send real postcards and letters; a person approves and pays, and Sendpaper prints and mails them via USPS.",
  "colors": {
    "primary": "#0F7A52",
    "light": "#4FD1A1",
    "dark": "#0B5E3F"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://sendmypaper.com"
  },
  "favicon": "/logo/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://sendmypaper.com/#pricing"
      },
      {
        "label": "Send from the web",
        "href": "https://sendmypaper.com/send"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Connect your agent",
      "href": "/quickstart"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "How-to guides",
            "pages": [
              "guides/send-a-postcard",
              "guides/send-a-letter",
              "guides/agent-payments",
              "guides/track-and-cancel",
              "guides/use-cases"
            ]
          },
          {
            "group": "Connect your agent",
            "pages": [
              "agents/codex",
              "agents/muse-code",
              "agents/claude",
              "agents/other-clients"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "guides/mcp-tools",
              "guides/order-lifecycle",
              "guides/products",
              "guides/content-policy",
              "guides/faq"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.json",
            "pages": [
              "GET /products",
              "POST /postcards",
              "POST /letters",
              "POST /orders/{id}/pay",
              "GET /orders/{id}",
              "POST /orders/{id}/cancel"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ryan-tish/sendpaper-plugin",
      "website": "https://sendmypaper.com"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Home",
            "href": "https://sendmypaper.com"
          },
          {
            "label": "Send mail",
            "href": "https://sendmypaper.com/send"
          },
          {
            "label": "Pricing",
            "href": "https://sendmypaper.com/#pricing"
          }
        ]
      },
      {
        "header": "For agents",
        "items": [
          {
            "label": "MCP endpoint",
            "href": "/agents/other-clients"
          },
          {
            "label": "OpenAPI spec",
            "href": "https://sendmypaper.com/openapi.json"
          },
          {
            "label": "llms.txt",
            "href": "https://sendmypaper.com/llms.txt"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Terms",
            "href": "https://sendmypaper.com/terms"
          },
          {
            "label": "Privacy",
            "href": "https://sendmypaper.com/privacy"
          },
          {
            "label": "Content policy",
            "href": "https://sendmypaper.com/content-policy"
          }
        ]
      }
    ]
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B100E"
    }
  },
  "appearance": {
    "default": "light"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "banner": {
    "content": "New: your agent can now pay for you. [See how agent payments work \u2192](/guides/agent-payments)",
    "dismissible": true,
    "color": {
      "light": "#0D1512",
      "dark": "#12291F"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "thumbnails": {
    "appearance": "light",
    "fonts": {
      "family": "Geist"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Sendpaper"
    }
  }
}
